[Unit]
Description=hailsDotGO, Pokemon GO Tools (pogo.hails.app)
After=network.target

[Service]
Type=simple
User=hailsdotgo
Group=hailsdotgo
WorkingDirectory=/opt/hailsdotgo
ExecStart=/opt/hailsdotgo/hailsDotGO
Restart=always
RestartSec=5
Environment=PORT=8080
# Runtime secrets and config (DB_*, SUPERADMIN_USER, CSRF_KEY, RESEND_API_KEY, etc.).
# deploy.ps1 writes this file (mode 600); for a manual install create it yourself.
EnvironmentFile=/opt/hailsdotgo/app.env

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
