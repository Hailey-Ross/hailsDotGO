VPS_HOST=your.server.ip.or.hostname
VPS_USER=your_ssh_user
VPS_PASS=your_ssh_password
DB_HOST=your.db.host:3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=hailsdotgo
SUPERADMIN_USER=yourAdminUsername
CSRF_KEY=generate_with_openssl_rand_hex_32
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_MODE=sandbox

# Screenshot OCR microservice (self-hosted RapidOCR; see ocr-service/README.md)
# Defaults to http://127.0.0.1:18265/ocr when unset.
OCR_SERVICE_URL=http://127.0.0.1:18265/ocr

# Transactional email via Resend (registration confirmation, password reset)
# Create a key named hailsdotgo at resend.com (Sending access only).
# MAIL_FROM must use a Resend-verified domain (hails.cc is verified).
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=hailsDotGO <noreply@hails.app>

# Canonical origin used in emailed links (password reset, email verify).
# Never derived from the request Host header. Falls back to https://pogo.hails.app when unset.
BASE_URL=https://pogo.hails.app

# Push notifications (optional -- mobile companion app)
# FCM_PROJECT_ID=your_firebase_project_id
# FCM_CREDENTIALS_JSON=/path/to/firebase-credentials.json
# APNS_KEY_PATH=/path/to/AuthKey_XXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_BUNDLE_ID=live.hails.pogo
# APNS_PRODUCTION=true